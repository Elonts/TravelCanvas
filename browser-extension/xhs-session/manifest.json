{
  "manifest_version": 3,
  "name": "TravelCanvas 小红书登录态补充",
  "version": "1.0.0",
  "description": "在用户主动连接后，读取小红书搜索页当前可见的公开结果卡，为本地 TravelCanvas 补充候选证据。",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://www.xiaohongshu.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "连接 TravelCanvas" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"],
      "js": ["travelcanvas-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["parser.js", "xhs-content.js"],
      "run_at": "document_idle"
    }
  ]
}
