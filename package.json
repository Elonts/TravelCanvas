{
  "name": "tripcanvas-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/**/*.test.mjs",
    "check": "npm run test && npm run build && npm run test:smoke",
    "test:smoke": "node tests/smoke.mjs",
    "test:browser": "node tests/browser.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:state": "wrangler deploy --config wrangler.state.jsonc",
    "deploy:cloudflare": "npm run deploy:state && npm run deploy:vinext"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.0-beta.10",
    "@vitejs/plugin-rsc": "^0.5.35",
    "playwright": "^1.55.1",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.12",
    "wrangler": "^4.140.0"
  }
}
