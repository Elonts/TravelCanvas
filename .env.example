DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AMAP_API_KEY=
# 高德 Web 服务用于酒店/车站/机场 POI 核验、驾车及公交路线步骤；不会提供实时铁路/航班票务。
# 高德 JS API 的浏览器端标识。必须在高德控制台限制为本机/正式站点域名；它不是服务端 Web API 密钥。
NEXT_PUBLIC_AMAP_JS_KEY=
# 高德 JS API 2.0 安全密钥，同样会在浏览器使用，请务必配置域名白名单。
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
TAVILY_API_KEY=
# 公开攻略在基础景区候选返回后单独检索；未配置、鉴权失败、限流、额度不足和超时会在页面分类提示，不阻塞基础路线。
# 可选：指定已手动安装 Scrapling 0.4.15 的 Python；设为 off 可明确关闭正文读取。
TRAVELCANVAS_SCRAPLING_PYTHON=
# Cloudflare Workers 首发部署设为 off；本地 Node 环境留空可使用受控联网补图。
TRAVELCANVAS_WEB_IMAGES=
