DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AMAP_API_KEY=
# 高德 JS API 的浏览器端标识。必须在高德控制台限制为本机/正式站点域名；它不是服务端 Web API 密钥。
NEXT_PUBLIC_AMAP_JS_KEY=
# 高德 JS API 2.0 安全密钥，同样会在浏览器使用，请务必配置域名白名单。
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
TAVILY_API_KEY=
# 可选：指定已手动安装 Scrapling 0.4.15 的 Python；设为 off 可明确关闭正文读取。
TRAVELCANVAS_SCRAPLING_PYTHON=
